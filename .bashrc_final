}

# 4. System List
syslist() {
    clear
    echo -e "\033[1;32m\t\t\t\t🖥️  SYSTEM DASHBOARD\033[0m"
    echo -e "\t\t\t\t-----------------------------------------------"
    echo -e "\t\t\t\t  checkup   : Check CPU, RAM & Disk"
    echo -e "\t\t\t\t  pyclean   : Clean Python __pycache__"
    echo -e "\t\t\t\t  config    : Edit .bashrc in VSCode"
    echo -e "\t\t\t\t  refresh   : Source .bashrc & Sync"
    echo -e "\t\t\t\t  sysupdate : System Update (sudo apt)"
    echo -e "\t\t\t\t-----------------------------------------------"
