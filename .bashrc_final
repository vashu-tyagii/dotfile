# 6. MySQL & Database Tools List
sqllist() {
    clear
    echo -e "\033[1;36m\t\t\t\t🗄️  MYSQL & DATABASE TOOLS\033[0m"
    echo -e "\t\t\t\t-----------------------------------------------"
