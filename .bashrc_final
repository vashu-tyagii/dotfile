# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
# Professional Clean Prompt
export PS1="\[\e[1;32m\]\u\[\e[m\]@\[\e[1;34m\]linux\[\e[m\]: \[\e[1;33m\]\W\[\e[m\] ➜ "
export PS1="\[\e[1;36m\]\${VIRTUAL_ENV+(.venv) }\[\e[1;32m\]\u\[\e[m\]@\[\e[1;34m\]linux\[\e[m\]: \[\e[1;33m\]\W\[\e[m\] ➜ "
export VIRTUAL_ENV_DISABLE_PROMPT=1
#================= Custom Aliases and Functions =================#

alias cls='clear' # Clear screen shortcut
alias config='code ~/dotfile/.bashrc_final && cls' # Edit bashrc in VSCode
alias py='_py(){ clear && uv run python "$1"; }; _py' # Run Python 3.14 file via uv and clear screen
alias pip='uv pip'
alias venv='uv venv --python 3.14 .venv && source .venv/bin/activate && uv pip install --upgrade pip && clear'
alias kuch_aur='...'
alias gl='git log --oneline --graph --all --decorate'
alias tc='_tc(){ touch "$1" && code "$1" && cls; }; _tc' # Create & open file in VSCode
alias un_pip='uv pip uninstall -y' # Uninstall package without confirmation via uv
alias gs='git status'


# Smart Toggle CD: VsCode in/out with one command

# --- Smart Post-Cleanup Pip Suite (Powered by UV) ---

# 1. Install packages and clear ONLY on success
in_pip() {
    echo -e "${CYAN}🚀 Installing: ${YELLOW}$*${NC}..."
    if uv pip install "$@"; then
        echo -e "${GREEN}✅ Installation Finished & Terminal Cleared!${NC}"
        sleep 2
        clear
    else
        echo -e "${RED}❌ Installation Failed! Check errors above.${NC}"
    fi
}

# 2. Upgrade packages and clear
up_pip() {
    echo -e "${CYAN}🔄 Upgrading: ${YELLOW}$*${NC}..."
    if uv pip install -U "$@"; then
        echo -e "${GREEN}✅ Upgrade Finished & Terminal Cleared!${NC}"
        sleep 2
        clear
    else
        echo -e "${RED}❌ Upgrade Failed!${NC}"
    fi
}

# 3. Requirements install and clear
re_pip() {
    if [ -f "requirements.txt" ]; then
        echo -e "${CYAN}📄 Installing from requirements.txt...${NC}"
        if uv pip install -r requirements.txt; then
            echo -e "${GREEN}✅ Requirements Installed & Terminal Cleared!${NC}"
            sleep 2
            clear
        fi
    else
        echo -e "${RED}❌ Error: requirements.txt not found!${NC}"
    fi
}

cd() {
    # 1. Smart Toggle Logic (VsCode in/out)
    local cd_ok=0
    if [ -z "$1" ]; then
        if [ "$PWD" == "$HOME/VsCode" ]; then
            builtin cd ~ && cls && cd_ok=1
        else
            builtin cd ~/VsCode && cls && cd_ok=1
        fi
    else
        builtin cd "$1" && cls && cd_ok=1
    fi

    # If the actual cd failed (bad path etc.), stop right here —
    # don't touch venv logic or clear the error away.
    if [ "$cd_ok" -eq 0 ]; then
        return 1
    fi

    # 2. Smart Recursive Venv Activation
    # Ye tab tak upar dekhega jab tak .venv na mil jaye ya Root tak na pahunch jaye
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -d "$dir/.venv" ]; then
            if [ "$VIRTUAL_ENV" != "$dir/.venv" ]; then
                source "$dir/.venv/bin/activate"
            fi
            clear
            return # Venv mil gaya, kaam khatam
        fi
        dir=$(dirname "$dir")
    done

    # 3. Agar kahin bhi .venv nahi mila, toh deactivate karo
    if [ -n "$VIRTUAL_ENV" ]; then
        deactivate
    fi
    
    clear
}

# Aur bhi behtar version (jisme tu message de sake):
gp() {  
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    git add .
    
    # Agar tumne koi message nahi diya, toh ye auto-message use karega
    if [ -z "$1" ]; then
        git commit -m "Auto-update from branch: $current_branch"
    else
        git commit -m "$1"
    fi

    git push origin "$current_branch" && cls
}

# System Update Function
sysupdate() {
   sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y && cls
}

# Python Cache Cleaner
pyclean() {
   find . -type d -name "__pycache__" -exec rm -rf {} +
}

# Make Directory and Change into it
mkcd() {
    mkdir -p "$1" && cd "$1" && cls
}

# System Resource Check
checkup() {
    echo "--- CPU & RAM Usage ---"
    free -h
    echo "--- Disk Space ---"
    df -h | grep '^/dev/'

    # --- INTERACTIVE PART ---
    echo -n "Press Enter to clear screen and continue..."
    read  # Yeh line wait karegi jab tak tu Enter nahi dabata
    cls   # Enter dabate hi screen saaf
}

refresh() {
    source ~/.bashrc && \
    cd ~/dotfile && gp "modified" && \
    cd - > /dev/null && \
    cls
}

Wsql() {
    clear
    local win_host="127.0.0.1"
    echo -e "\033[1;36mConnecting to Windows MySQL at ${win_host}...\033[0m"
    mysql -h "$win_host" -u root -p
}

db() {
    clear
    if [ -z "$1" ]; then
        echo "Usage: db <database_name>"
        return 1
    fi

    local db_name="$1"
    local win_host="127.0.0.1"
    local host_flag="-h $win_host -u root -p"
    local host_label="Windows @ $win_host"

    # Check if database exists
    local exists=$(mysql $host_flag -N -e "SHOW DATABASES LIKE '$db_name';" 2>/dev/null)

    if [ -z "$exists" ]; then
        echo -ne "\033[1;33m⚠️  Database '$db_name' does not exist on $host_label. Create it? (y/n): \033[0m"
        read confirm
        if [ "$confirm" == "y" ] || [ "$confirm" == "Y" ]; then
            mysql $host_flag -e "CREATE DATABASE $db_name;"
            if [ $? -ne 0 ]; then
                echo "❌ Failed to create database '$db_name'."
                return 1
            fi
            echo "✅ Database '$db_name' created on $host_label."
        else
            echo "❌ Cancelled. Database not selected."
            return 1
        fi
    fi

    export CURRENT_DB="$db_name"
    export CURRENT_DB_HOST="$win_host"

    echo "✅ Database selected: $CURRENT_DB ($host_label)"
    sleep 1 && clear
}

Runsql() {
    clear
    if [ -z "$CURRENT_DB" ]; then
        echo "No database selected. Pehle 'db <database_name>' chalao."
        return 1
    fi
    if [ -z "$1" ]; then
        echo "Usage: Runsql <file.sql>"
        return 1
    fi
    if [ ! -f "$1" ]; then
        echo "File not found: $1"
        return 1
    fi
    if [ -z "$CURRENT_DB_HOST" ]; then
        mysql -t "$CURRENT_DB" < "$1"
    else
        mysql -t -h "$CURRENT_DB_HOST" -u root -p "$CURRENT_DB" < "$1"
    fi
}

Whichdb() {
    clear
    if [ -z "$CURRENT_DB" ]; then
        echo "No database selected yet. Pehle 'db <database_name>' chalao."
        return 1
    fi
    echo "Current DB: $CURRENT_DB  |  Location: Windows (Host: ${CURRENT_DB_HOST:-127.0.0.1})"
}

gk() {
    find . -type d -empty -not -path "./.git/*" -exec touch {}/.gitkeep \;
    echo "✅ .gitkeep files created in all empty directories."
}

# Wipe git history and start fresh with a single clean commit
gitreset() {
    echo "⚠️  WARNING: This will PERMANENTLY DELETE all commit history on this repo."
    read -p "Type 'yes' to confirm: " confirm
    if [ "$confirm" != "yes" ]; then
        echo "❌ Cancelled. No changes made."
        return 1
    fi
    git checkout --orphan temp && \
    git add -A && \
    git commit -m "Initial commit" && \
    git branch -M main && \
    git push -f origin main && \
    echo "✅ History reset complete."
    sleep 1
    cls
}

