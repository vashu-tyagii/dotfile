# 1. Main Master List
list() {
    clear
    echo -e "\t\t\t\t\033[1;33m==============================================="
    echo -e "\t\t\t\t            🚀 TERMINAL MASTER MENU             "
    echo -e "\t\t\t\t==============================================="
    echo -e "\033[0m"
    echo -e "\033[1;32m\t\t\t\t  piplist   \033[0m : Python & Pip Shortcuts"
    echo -e "\033[1;32m\t\t\t\t  gitlist   \033[0m : Git & GitHub Automation"
    echo -e "\033[1;32m\t\t\t\t  syslist   \033[0m : System & Config Tools" 
    echo -e "\033[1;32m\t\t\t\t  autolist  \033[0m : Automation & Workflow Tools"
    echo -e "\033[1;32m\t\t\t\t  sqllist  \033[0m : MySQL & Database Tools"
    echo -e "\t\t\t\t"
    echo -e "\033[1;33m\t\t\t\t===============================================\033[0m"
}

# 2. Python & Pip List (Act/Deact removed)
piplist() {
    clear
    echo -e "\033[1;35m\t\t\t\t📦 PYTHON & PIP DASHBOARD\033[0m"
    echo -e "\t\t\t\t-----------------------------------------------"
    echo -e "\t\t\t\t  in_pip   : Install package"
    echo -e "\t\t\t\t  up_pip   : Upgrade package"
    echo -e "\t\t\t\t  re_pip   : Install from requirements.txt"
    echo -e "\t\t\t\t  un_pip   : Uninstall package"
    echo -e "\t\t\t\t-----------------------------------------------"
    echo -ne "\t\t\t\t\n Enter to return to Master Menu..."
    read && list
}

# 3. Git & GitHub List
gitlist() {
    clear
    echo -e "\033[1;36m\t\t\t\t📂 GIT & GITHUB DASHBOARD\033[0m"
    echo -e "\t\t\t\t-----------------------------------------------"
    echo -e "\t\t\t\t  gs       : Git Status"
    echo -e "\t\t\t\t  gp       : Git Push (Auto-commit)"
    echo -e "\t\t\t\t  gl       : Git Log (Graph view)"
    echo -e "\t\t\t\t  gk       : Create .gitkeep files in all directories"
    echo -e "\t\t\t\t  gitreset : Fresh Git Initialization"
    echo -e "\t\t\t\t-----------------------------------------------"
    echo -ne "\t\t\t\t\n Press Enter to return to Master Menu..."
